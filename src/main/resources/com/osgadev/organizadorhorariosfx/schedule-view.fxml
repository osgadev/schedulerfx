<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import java.lang.String?>

<BorderPane prefHeight="700.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.osgadev.organizadorhorariosfx.controller.ScheduleController">

    <!-- ZONA SUPERIOR: CONTEXTO (AÑO Y ETAPA) -->
    <top>
        <!-- AtlantaFX: bg-subtle para fondos suaves y border-bottom para separador -->
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="15.0" BorderPane.alignment="CENTER">
            <styleClass>
                <String fx:value="bg-subtle" />
                <String fx:value="border-bottom" />
            </styleClass>
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
            </padding>
            <children>
                <!-- AtlantaFX: title-4 (tamaño de título) -->
                <Label text="Gestión de Horarios">
                    <styleClass>
                        <String fx:value="title-4" />
                    </styleClass>
                </Label>

                <Separator orientation="VERTICAL" />

                <Label text="Año:" />
                <ComboBox fx:id="cmbAnio" prefWidth="100.0" />
                <Label text="Etapa:" />
                <ComboBox fx:id="cmbEtapa" prefWidth="100.0" />

                <!-- AtlantaFX: accent (Botón principal destacado) -->
                <Button fx:id="btnCargar" mnemonicParsing="false" onAction="#cargarHorario" text="Buscar / Cargar">
                    <styleClass>
                        <String fx:value="accent" />
                    </styleClass>
                </Button>
            </children>
        </HBox>
    </top>

    <!-- ZONA IZQUIERDA: ALMACÉN MANUAL -->
    <left>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minWidth="260.0" prefWidth="260.0" BorderPane.alignment="CENTER">
            <content>
                <!-- AtlantaFX: bg-subtle y border-right para el borde divisor -->
                <VBox spacing="10.0">
                    <styleClass>
                        <String fx:value="bg-subtle" />
                        <String fx:value="border-right" />
                    </styleClass>
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                    </padding>
                    <children>

                        <Label text="Anclaje Manual">
                            <styleClass>
                                <String fx:value="title-4" />
                            </styleClass>
                        </Label>

                        <Label text="1. Seleccionar Profesor:">
                            <styleClass>
                                <String fx:value="text-bold" />
                            </styleClass>
                        </Label>
                        <ComboBox fx:id="cmbProfesorManual" maxWidth="1.7976931348623157E308" promptText="Elegir profesor..." />

                        <Separator />

                        <Label text="2. Grupos Pendientes:">
                            <styleClass>
                                <String fx:value="text-bold" />
                            </styleClass>
                        </Label>
                        <Label text="Selecciona la materia para generar los bloques." wrapText="true">
                            <styleClass>
                                <String fx:value="text-muted" />
                                <String fx:value="text-small" />
                            </styleClass>
                        </Label>

                        <ListView fx:id="listGruposPendientes" prefHeight="250.0" VBox.vgrow="ALWAYS">
                            <!-- AtlantaFX: dense para que los items de la lista estén más compactos -->
                            <styleClass>
                                <String fx:value="dense" />
                            </styleClass>
                        </ListView>

                        <!-- Panel de Generador de bloques: estilo tarjeta de AtlantaFX (elevated-1) -->
                        <VBox spacing="8.0">
                            <styleClass>
                                <String fx:value="bg-default" />
                                <String fx:value="elevated-1" />
                            </styleClass>
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                            <children>
                                <Label text="3. Generador de Bloques">
                                    <styleClass>
                                        <String fx:value="text-bold" />
                                    </styleClass>
                                </Label>
                                <Label fx:id="lblMateriaSeleccionada" text="Selecciona una materia" wrapText="true">
                                    <styleClass>
                                        <String fx:value="text-bold" />
                                        <String fx:value="accent" />
                                    </styleClass>
                                </Label>
                                <Label fx:id="lblHorasRestantes" text="---">
                                    <styleClass>
                                        <String fx:value="text-bold" />
                                        <String fx:value="warning" />
                                    </styleClass>
                                </Label>

                                <HBox fx:id="cajaBloquesGeneradores" alignment="CENTER" spacing="8.0">
                                    <VBox.margin><Insets top="5.0" /></VBox.margin>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </left>

    <!-- ZONA CENTRAL: TABLERO -->
    <center>
        <StackPane BorderPane.alignment="CENTER">
            <children>
                <VBox fx:id="fase1Vacia" alignment="CENTER" spacing="10.0">
                    <children>
                        <Label text="Aún no se ha generado ningún horario para este ciclo.&#10;Puedes acomodar bloques manualmente desde el panel izquierdo,&#10;o presionar 'Autocompletar (IA)' para usar la Inteligencia Artificial." textAlignment="CENTER">
                            <styleClass>
                                <String fx:value="text-muted" />
                                <String fx:value="title-5" />
                            </styleClass>
                        </Label>
                    </children>
                </VBox>
                <ScrollPane fx:id="scrollCalendario" fitToHeight="true" fitToWidth="true">
                    <!-- AtlantaFX: bg-default -->
                    <styleClass>
                        <String fx:value="bg-default" />
                    </styleClass>
                    <content>
                        <GridPane fx:id="gridCalendario">
                            <styleClass>
                                <String fx:value="bg-default" />
                            </styleClass>
                            <padding>
                                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                            </padding>
                        </GridPane>
                    </content>
                </ScrollPane>
            </children>
        </StackPane>
    </center>

    <!-- ZONA DERECHA: ACCIONES Y FILTROS -->
    <right>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minWidth="240.0" prefWidth="240.0" BorderPane.alignment="CENTER">
            <content>
                <VBox spacing="15.0">
                    <styleClass>
                        <String fx:value="bg-subtle" />
                        <String fx:value="border-left" />
                    </styleClass>
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                    </padding>
                    <children>

                        <Label text="Motor IA y BD">
                            <styleClass>
                                <String fx:value="title-4" />
                            </styleClass>
                        </Label>

                        <!-- AtlantaFX: Botones semánticos (success, warning, accent, danger) -->
                        <Button fx:id="btnGenerar" disable="true" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#generarHorario" text="Autocompletar (IA)">
                            <styleClass>
                                <String fx:value="success" />
                            </styleClass>
                        </Button>

                        <Button fx:id="btnExportarExcel" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#exportarAExcel" text="Exportar a Excel">
                            <styleClass>
                                <String fx:value="success" />
                                <String fx:value="outlined" />
                            </styleClass>
                        </Button>

                        <Button fx:id="btnPausar" disable="true" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#togglePausaIA" text="Pausar IA">
                            <styleClass>
                                <String fx:value="warning" />
                            </styleClass>
                        </Button>

                        <Button fx:id="btnSiguientePaso" disable="true" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#siguientePasoIA" text="Siguiente Paso">
                            <styleClass>
                                <String fx:value="accent" />
                            </styleClass>
                        </Button>

                        <Button fx:id="btnToggleSugerencias" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#toggleSugerencias" text="Ocultar Sugerencias">
                            <!-- Si deseas el color morado que tenías antes de atlantafx, deberás redefinirlo en CSS, de lo contrario usamos el outlined accent -->
                            <styleClass>
                                <String fx:value="accent" />
                                <String fx:value="flat" />
                            </styleClass>
                        </Button>

                        <Label fx:id="lblEstadoIA" text="Estado de la IA..." wrapText="true">
                            <styleClass>
                                <String fx:value="text-bold" />
                                <String fx:value="accent" />
                            </styleClass>
                        </Label>

                        <Separator />

                        <Button fx:id="btnGuardarBD" disable="true" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#guardarEnBD" text="💾 Guardar en BD">
                            <styleClass>
                                <String fx:value="outlined" />
                            </styleClass>
                        </Button>
                        <Button fx:id="btnBorrarBD" disable="true" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#borrarDeBD" text="🗑 Borrar Horario">
                            <styleClass>
                                <String fx:value="danger" />
                            </styleClass>
                        </Button>

                        <Separator />

                        <Label text="Filtros Visuales">
                            <styleClass>
                                <String fx:value="title-4" />
                            </styleClass>
                        </Label>
                        <Label text="Filtrar por Curso:" />
                        <ComboBox fx:id="cmbFiltroCurso" maxWidth="1.7976931348623157E308" />
                        <Label text="Filtrar por Profesor:" />
                        <ComboBox fx:id="cmbFiltroProfesor" maxWidth="1.7976931348623157E308" />

                        <Button fx:id="btnLimpiarFiltros" contentDisplay="CENTER" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="25.0" text="Limpiar Filtros">
                            <styleClass>
                                <String fx:value="flat" />
                            </styleClass>
                        </Button>

                        <Separator />

                        <Label text="Mostrar en bloques:" />
                        <CheckBox fx:id="chkRangoAlumnos" selected="true" text="Rango de students" wrapText="true">
                            <styleClass>
                                <String fx:value="text-bold" />
                            </styleClass>
                        </CheckBox>
                        <CheckBox fx:id="chkProfesor" selected="true" text="Profesor" />
                        <CheckBox fx:id="chkIdGrupo" text="ID de Grupo" />
                        <CheckBox fx:id="chkNombreCurso" selected="true" text="Nombre del Curso" wrapText="true" />

                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </right>
</BorderPane>