<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="teacherAnchorPane" prefHeight="500.0" prefWidth="600.0" spacing="20.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.osgadev.organizadorhorariosfx.controller.TeacherController">
    <padding>
        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
    </padding>
    <children>

        <!-- ============================================== -->
        <!-- ENCABEZADO: TÍTULO Y BOTONES DE ACCIÓN         -->
        <!-- ============================================== -->
        <HBox alignment="BOTTOM_LEFT" prefHeight="50.0" prefWidth="550.0">
            <children>
                <VBox spacing="5.0">
                    <children>
                        <Label text="Gestión de Profesores">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                        <Label text="Administra el catálogo de docentes y sus materias asignadas" textFill="#666666">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <!-- Resorte invisible para empujar el botón a la derecha -->
                <Region HBox.hgrow="ALWAYS" />

                <Button fx:id="addNewTeacherButton" alignment="CENTER" graphicTextGap="10.0" mnemonicParsing="false" onAction="#onAddNewTeacherButtonClick" prefHeight="35.0" style="-fx-background-color: #28a745; -fx-background-radius: 4; -fx-font-weight: bold;" text="Nuevo Profesor" textFill="WHITE">
                    <graphic>
                        <ImageView fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../../images/adduser.png" />
                            </image>
                        </ImageView>
                    </graphic>
                    <padding>
                        <Insets left="15.0" right="15.0" />
                    </padding>
                </Button>
            </children>
        </HBox>

        <!-- ============================================== -->
        <!-- ÁREA CENTRAL: TABLA DE DATOS                   -->
        <!-- ============================================== -->
        <TableView fx:id="tablaProfesores" VBox.vgrow="ALWAYS" style="-fx-border-color: #dddddd; -fx-border-radius: 4; -fx-background-radius: 4;">
            <columns>
                <TableColumn fx:id="colNumeroProfesor" maxWidth="50.0" minWidth="40.0" prefWidth="45.0" text="No." />
                <TableColumn fx:id="colNombre" minWidth="150.0" prefWidth="200.0" text="Nombre Completo" />
                <TableColumn fx:id="colCursos" minWidth="150.0" prefWidth="200.0" text="Cursos Asignados" />
                <TableColumn fx:id="colAcciones" maxWidth="150.0" minWidth="120.0" prefWidth="120.0" text="Acciones" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

    </children>
</VBox>
