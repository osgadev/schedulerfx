<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1024.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.osgadev.organizadorhorariosfx.controller.AvailabilityController">

    <top>
        <VBox spacing="2.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <children>
                <Label styleClass="title-3" text="Organizador de Disponibilidad" />
                <Label styleClass="text-muted" text="Haz doble clic para crear bloques. Usa Ctrl + clic para seleccionar varios. Arrastra los bordes para ajustar el tiempo." />
            </children>
        </VBox>
    </top>

    <center>
        <VBox>
            <GridPane>
                <columnConstraints>
                    <ColumnConstraints hgrow="NEVER" minWidth="50.0" prefWidth="50.0" />
                    <ColumnConstraints hgrow="ALWAYS" minWidth="60.0" prefWidth="100.0" />
                    <ColumnConstraints hgrow="ALWAYS" minWidth="60.0" prefWidth="100.0" />
                    <ColumnConstraints hgrow="ALWAYS" minWidth="60.0" prefWidth="100.0" />
                    <ColumnConstraints hgrow="ALWAYS" minWidth="60.0" prefWidth="100.0" />
                    <ColumnConstraints hgrow="ALWAYS" minWidth="60.0" prefWidth="100.0" />
                    <ColumnConstraints hgrow="ALWAYS" minWidth="60.0" prefWidth="100.0" />
                    <ColumnConstraints hgrow="ALWAYS" minWidth="60.0" prefWidth="100.0" />
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="30.0" prefHeight="30.0" />
                </rowConstraints>
                <padding>
                    <Insets bottom="5.0" left="5.0" right="15.0" top="5.0" />
                </padding>
                <children>
                    <Label styleClass="text-muted" text="Hora" GridPane.columnIndex="0" GridPane.halignment="CENTER" />
                    <Label styleClass="text-bold" text="Lunes" GridPane.columnIndex="1" GridPane.halignment="CENTER" />
                    <Label styleClass="text-bold" text="Martes" GridPane.columnIndex="2" GridPane.halignment="CENTER" />
                    <Label styleClass="text-bold" text="Miércoles" GridPane.columnIndex="3" GridPane.halignment="CENTER" />
                    <Label styleClass="text-bold" text="Jueves" GridPane.columnIndex="4" GridPane.halignment="CENTER" />
                    <Label styleClass="text-bold" text="Viernes" GridPane.columnIndex="5" GridPane.halignment="CENTER" />
                    <Label styleClass="text-bold" text="Sábado" GridPane.columnIndex="6" GridPane.halignment="CENTER" />
                    <Label styleClass="text-bold" text="Domingo" GridPane.columnIndex="7" GridPane.halignment="CENTER" />
                </children>
            </GridPane>
            <Separator />

            <ScrollPane fx:id="scrollCalendario" fitToWidth="true" VBox.vgrow="ALWAYS">
                <content>
                    <GridPane fx:id="gridCalendario">
                        <columnConstraints>
                            <ColumnConstraints hgrow="NEVER" minWidth="50.0" prefWidth="50.0" />
                            <ColumnConstraints hgrow="ALWAYS" minWidth="60.0" prefWidth="100.0" />
                            <ColumnConstraints hgrow="ALWAYS" minWidth="60.0" prefWidth="100.0" />
                            <ColumnConstraints hgrow="ALWAYS" minWidth="60.0" prefWidth="100.0" />
                            <ColumnConstraints hgrow="ALWAYS" minWidth="60.0" prefWidth="100.0" />
                            <ColumnConstraints hgrow="ALWAYS" minWidth="60.0" prefWidth="100.0" />
                            <ColumnConstraints hgrow="ALWAYS" minWidth="60.0" prefWidth="100.0" />
                            <ColumnConstraints hgrow="ALWAYS" minWidth="60.0" prefWidth="100.0" />
                        </columnConstraints>
                        <padding>
                            <Insets bottom="10.0" left="5.0" right="10.0" top="5.0" />
                        </padding>
                    </GridPane>
                </content>
            </ScrollPane>
        </VBox>
    </center>

    <right>
        <VBox prefWidth="260.0" spacing="20.0" style="-fx-background-color: -color-bg-subtle; -fx-border-color: -color-border-subtle; -fx-border-width: 0 0 0 1;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>

                <VBox spacing="8.0">
                    <children>
                        <Label styleClass="title-4" text="Profesor" />
                        <ComboBox fx:id="cmbProfesor" maxWidth="1.7976931348623157E308" prefHeight="32.0" promptText="Seleccionar docente..." />
                    </children>
                </VBox>

                <Separator />

                <VBox fx:id="panelControles" disable="true" spacing="20.0" VBox.vgrow="ALWAYS">
                    <children>

                        <VBox spacing="10.0">
                            <children>
                                <Label styleClass="title-4" text="Asignación de Cursos" />
                                <Label styleClass="text-muted, text-small" text="Selecciona uno o varios bloques en el calendario y elige una materia:" wrapText="true" />
                                <FlowPane fx:id="paletaCursos" hgap="8.0" vgap="8.0" />
                            </children>
                        </VBox>

                        <Pane VBox.vgrow="ALWAYS" />

                        <VBox alignment="BOTTOM_CENTER" spacing="12.0">
                            <children>
                                <Label fx:id="lblEstadoBD" alignment="CENTER" maxWidth="1.7976931348623157E308" style="-fx-font-size: 13px;" styleClass="text-muted" text="Esperando configuración..." textAlignment="CENTER" wrapText="true" />
                                <Separator />
                                <Button fx:id="btnGuardar" maxWidth="1.7976931348623157E308" prefHeight="38.0" style="-fx-font-weight: bold; -fx-font-size: 13px;" styleClass="success" text="Guardar Calendario" />
                                <Button fx:id="btnEliminarTodo" maxWidth="1.7976931348623157E308" prefHeight="36.0" styleClass="danger, outlined" text="Limpiar Calendario" />
                            </children>
                        </VBox>

                    </children>
                </VBox>
            </children>
        </VBox>
    </right>
</BorderPane>