<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.osgadev.organizadorhorariosfx.controller.GroupController">

   <!-- ============================================== -->
   <!-- TOP: BARRA DE HERRAMIENTAS Y TÍTULO            -->
   <!-- ============================================== -->
   <!-- ============================================== -->
   <!-- TOP: BARRA DE HERRAMIENTAS COMPACTA            -->
   <!-- ============================================== -->
   <top>
      <VBox spacing="10.0" style="-fx-border-color: transparent transparent #dddddd transparent; -fx-border-width: 1;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
         </padding>

         <!-- Título y Subtítulo de Materia -->
         <HBox alignment="BOTTOM_LEFT" spacing="15.0">
            <Label text="Gestión de Grupos">
               <font><Font name="System Bold" size="22.0" /></font>
            </Label>
            <Label fx:id="lblCursoActual" text="Materia: -" textFill="#666666">
               <font><Font size="14.0" /></font>
            </Label>
         </HBox>

         <!-- Contenedor de Estados -->
         <StackPane alignment="CENTER_LEFT">

            <!-- ESTADO 1: MODO CONSULTA -->
            <HBox fx:id="panelConsulta" alignment="BOTTOM_LEFT" spacing="15.0" visible="false">
               <!-- Agrupación Label + Input apilados -->
               <VBox spacing="3.0">
                  <Label text="Año" textFill="#555555"><font><Font size="11.0" /></font></Label>
                  <ComboBox fx:id="cbAnioConsulta" prefWidth="100.0" promptText="2026" />
               </VBox>

               <VBox spacing="3.0">
                  <Label text="Etapa" textFill="#555555"><font><Font size="11.0" /></font></Label>
                  <ComboBox fx:id="cbEtapaConsulta" editable="true" prefWidth="90.0" />
               </VBox>

               <!-- Botón alineado a la parte inferior gracias al HBox alignment="BOTTOM_LEFT" -->
               <Button mnemonicParsing="false" onAction="#onBuscarBDClick" prefHeight="25.0" text="Buscar en BD" />

               <Region HBox.hgrow="ALWAYS" />

               <!-- Botones de Acción (Lado Derecho) -->
               <Button mnemonicParsing="false" onAction="#onEliminarGruposClick" prefHeight="25.0" style="-fx-text-fill: #d32f2f; -fx-border-color: #d32f2f; -fx-background-color: transparent; -fx-border-radius: 3;" text="Eliminar Selección" />
               <Button mnemonicParsing="false" onAction="#onActivarModoCreacionClick" prefHeight="25.0" style="-fx-base: #1976D2; -fx-text-fill: white; -fx-font-weight: bold;" text="+ Generar Nuevos" />
            </HBox>

            <!-- ESTADO 2: MODO CREACIÓN -->
            <HBox fx:id="panelCreacion" alignment="BOTTOM_LEFT" spacing="15.0">

               <VBox spacing="3.0">
                  <Label text="Total Alumnos" textFill="#555555"><font><Font size="11.0" /></font></Label>
                  <TextField fx:id="txtTotalAlumnos" prefWidth="100.0" promptText="Ej. 500" />
               </VBox>

               <VBox spacing="3.0">
                  <Label text="Año Destino" textFill="#555555"><font><Font size="11.0" /></font></Label>
                  <ComboBox fx:id="cbAnioCreacion" prefWidth="100.0" promptText="2026" />
               </VBox>

               <VBox spacing="3.0">
                  <Label text="Etapa Destino" textFill="#555555"><font><Font size="11.0" /></font></Label>
                  <ComboBox fx:id="cbEtapaCreacion" editable="true" prefWidth="90.0" promptText="1" />
               </VBox>

               <Button mnemonicParsing="false" onAction="#onGenerarBorradorClick" prefHeight="25.0" text="Calcular Borrador" />

               <Region HBox.hgrow="ALWAYS" />

               <Button mnemonicParsing="false" onAction="#onCancelarCreacionClick" prefHeight="25.0" text="Cancelar" />
               <Button fx:id="btnGuardarBD" disable="true" mnemonicParsing="false" onAction="#onGuardarEnBDClick" prefHeight="25.0" style="-fx-base: #388E3C; -fx-text-fill: white; -fx-font-weight: bold;" text="Guardar Confirmados" />
            </HBox>
         </StackPane>
      </VBox>
   </top>

   <!-- ============================================== -->
   <!-- CENTER: TABLA PRINCIPAL Y MENSAJES             -->
   <!-- ============================================== -->
   <center>
      <StackPane fx:id="stackPaneCentral" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="10.0" top="5.0" />
         </padding>

         <TableView fx:id="tablaGrupos">
            <columns>
               <TableColumn fx:id="colNumeroGrupo" prefWidth="50.0" text="No." />
               <TableColumn fx:id="colProfesor" prefWidth="250.0" text="Profesor Asignado" />
               <TableColumn fx:id="colIdGrupo" prefWidth="120.0" text="ID Grupo" />
               <TableColumn fx:id="colAlumnos" prefWidth="100.0" text="Tamaño" />
               <TableColumn fx:id="colRango" prefWidth="120.0" text="Rango de Lista" />
            </columns>
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
         </TableView>

         <VBox fx:id="vistaVaciaVBox" alignment="CENTER" spacing="10.0" style="-fx-background-color: #f9f9f9; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-background-radius: 5;">
            <Label text="Sin Datos Activos" textFill="#888888">
               <font><Font name="System Bold" size="22.0" /></font>
            </Label>
            <Label fx:id="lblMensajeVacio" text="Selecciona un año y etapa para consultar, o genera nuevos grupos." textFill="#666666">
               <font><Font size="14.0" /></font>
            </Label>
         </VBox>
      </StackPane>
   </center>

   <!-- ============================================== -->
   <!-- RIGHT: PANEL DE NAVEGACIÓN Y ESTADÍSTICAS      -->
   <!-- ============================================== -->
   <right>
      <VBox alignment="TOP_CENTER" prefWidth="160.0" spacing="10.0" style="-fx-background-color: #f4f4f4; -fx-border-color: #dddddd; -fx-border-width: 0 0 0 1;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
         </padding>

         <Label text="Navegación" textFill="#555555">
            <font><Font name="System Bold" size="14.0" /></font>
         </Label>

         <HBox alignment="CENTER" spacing="15.0">
            <Button fx:id="btnAnterior" mnemonicParsing="false" onAction="#onAnteriorClick" prefWidth="40.0" text="&lt;">
               <font><Font name="System Bold" size="14.0" /></font>
            </Button>
            <Button fx:id="btnSiguiente" mnemonicParsing="false" onAction="#onSiguienteClick" prefWidth="40.0" text="&gt;">
               <font><Font name="System Bold" size="14.0" /></font>
            </Button>
         </HBox>

         <Region prefHeight="20.0" />

         <Label text="Resumen del Ciclo" textFill="#555555">
            <font><Font name="System Bold" size="14.0" /></font>
         </Label>

         <VBox alignment="CENTER" spacing="5.0" style="-fx-background-color: white; -fx-padding: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 5;">
            <Label text="Alumnos" textFill="#777777" />
            <Label fx:id="lblTotalAlumnos" text="0">
               <font><Font name="System Bold" size="18.0" /></font>
            </Label>
         </VBox>

         <VBox alignment="CENTER" spacing="5.0" style="-fx-background-color: white; -fx-padding: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 5;">
            <Label text="Profesores" textFill="#777777" />
            <Label fx:id="lblTotalProfesores" text="0">
               <font><Font name="System Bold" size="18.0" /></font>
            </Label>
         </VBox>

         <VBox alignment="CENTER" spacing="5.0" style="-fx-background-color: white; -fx-padding: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 5;">
            <Label text="Cursos" textFill="#777777" />
            <Label fx:id="lblTotalCursos" text="0">
               <font><Font name="System Bold" size="18.0" /></font>
            </Label>
         </VBox>

         <VBox alignment="CENTER" spacing="5.0" style="-fx-background-color: white; -fx-padding: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 5;">
            <Label text="Total Grupos" textFill="#777777" />
            <Label fx:id="lblTotalGrupos" text="0" textFill="#2e7d32">
               <font><Font name="System Bold" size="18.0" /></font>
            </Label>
         </VBox>

      </VBox>
   </right>

</BorderPane>
