<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="223.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.osgadev.organizadorhorariosfx.controller.CourseFormController">
   <children>
      <Label layoutX="14.0" layoutY="14.0" text="Información del curso">
         <font>
            <Font name="System Bold" size="15.0" />
         </font>
      </Label>
      <TextField fx:id="nombreCursoTextField" layoutX="14.0" layoutY="75.0" promptText="Nombre del curso">
         <font>
            <Font size="14.0" />
         </font>
      </TextField>
      <TextField fx:id="horasSemanaTextField" layoutX="230.0" layoutY="75.0" prefHeight="25.0" prefWidth="104.0" promptText="Ej: 5">
         <font>
            <Font size="14.0" />
         </font>
      </TextField>
      <Label layoutX="14.0" layoutY="53.0" text="Nombre:">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <Label layoutX="230.0" layoutY="53.0" text="Horas semanales:">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <Button fx:id="saveButton" layoutX="69.0" layoutY="158.0" mnemonicParsing="false" onAction="#onSaveButtonClick" prefHeight="34.0" prefWidth="98.0" style="-fx-background-color: #6c3464;" text="Guardar" textFill="WHITE">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>
      <Button fx:id="cancelButton" layoutX="240.0" layoutY="158.0" mnemonicParsing="false" onAction="#onCancelButtonClick" prefHeight="34.0" prefWidth="98.0" style="-fx-background-color: white; -fx-border-color: #6c3464;" text="Cancelar" textFill="#6c3464">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>
      <Label fx:id="mainMessageLabel" alignment="CENTER" layoutX="-1.0" layoutY="115.0" prefHeight="17.0" prefWidth="400.0" textFill="RED" />
      <Label fx:id="secondaryMessageLabel" alignment="CENTER" layoutX="5.0" layoutY="132.0" prefHeight="17.0" prefWidth="400.0" textFill="RED" />
   </children>
</AnchorPane>
