<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="472.0" prefWidth="563.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.osgadev.organizadorhorariosfx.controller.TeacherFormController">
   <children>
      <Label layoutX="48.0" layoutY="27.0" text="Información del Profesor">
         <font>
            <Font name="System Bold" size="15.0" />
         </font>
      </Label>
      <Label layoutX="48.0" layoutY="108.0" text="Nombre" />
      <TextField fx:id="nombreProfesorTextField" layoutX="48.0" layoutY="125.0" prefHeight="25.0" prefWidth="177.0" />
      <Label layoutX="48.0" layoutY="166.0" text="Apellido Paterno" />
      <TextField fx:id="apellidoPProfesorTextField" layoutX="48.0" layoutY="183.0" prefHeight="25.0" prefWidth="177.0" />
      <Label layoutX="48.0" layoutY="229.0" text="Apellido Materno" />
      <TextField fx:id="apellidoMProfesorTextField" layoutX="48.0" layoutY="246.0" prefHeight="25.0" prefWidth="177.0" />
      <Label layoutX="48.0" layoutY="288.0" text="Correo Electronico" />
      <TextField fx:id="correoEProfesorTextField" layoutX="48.0" layoutY="305.0" prefHeight="25.0" prefWidth="177.0" />
      <Label layoutX="48.0" layoutY="345.0" text="Telefono" />
      <TextField fx:id="telefonoProfesorTextField" layoutX="49.0" layoutY="362.0" prefHeight="25.0" prefWidth="177.0" />
      <Button fx:id="btnAgregarCurso" layoutX="424.0" layoutY="117.0" mnemonicParsing="false" onAction="#agregarCursoATabla" text="Agregar" />
      <ComboBox fx:id="cursosCombo" layoutX="304.0" layoutY="117.0" prefHeight="25.0" prefWidth="105.0" promptText="Seleccionar" />
      <Separator layoutX="254.0" layoutY="73.0" orientation="VERTICAL" prefHeight="312.0" prefWidth="32.0" />
      <Separator layoutX="48.0" layoutY="57.0" prefHeight="5.0" prefWidth="495.0" />
      <TableView fx:id="tableCursos" layoutX="300.0" layoutY="154.0" prefHeight="234.0" prefWidth="227.0">
        <columns>
          <TableColumn fx:id="colNombreCurso" prefWidth="180.0" text="Curso" />
            <TableColumn fx:id="colAcciones" prefWidth="45.0" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <Button fx:id="guardarButton" layoutX="112.0" layoutY="415.0" mnemonicParsing="false" onAction="#onSaveButtonClick" prefHeight="25.0" prefWidth="142.0" text="Guardar">
         <font>
            <Font size="14.0" />
         </font></Button>
      <Button fx:id="cancelButton" layoutX="286.0" layoutY="415.0" mnemonicParsing="false" onAction="#onCancelButtonClick" prefHeight="25.0" prefWidth="142.0" text="Cancelar">
         <font>
            <Font size="14.0" />
         </font></Button>
      <Label layoutX="48.0" layoutY="79.0" prefHeight="21.0" prefWidth="142.0" text="Personal y contacto">
         <font>
            <Font size="15.0" />
         </font>
      </Label>
      <Label layoutX="304.0" layoutY="79.0" prefHeight="21.0" prefWidth="76.0" text="Cursos">
         <font>
            <Font size="15.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
